{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers (modelo compatível com Next.js via OpenNext).
  // O "Pages" clássico não executa o runtime do Next.js 16 (App Router,
  // Server Actions, proxy); por isso o deploy usa Workers + Assets.
  "name": "ponto-do-pedido",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "ponto-do-pedido" }],
  "observability": { "enabled": true },
  "workers_dev": true,
  // Rotas do domínio próprio (pontodopedido.com e *.pontodopedido.com) estão
  // suspensas até a zona estar ativa na conta Cloudflare; sem elas o deploy
  // publica em *.workers.dev. Para reativar, adicione de volta:
  // "routes": [
  //   { "pattern": "pontodopedido.com/*", "zone_name": "pontodopedido.com" },
  //   { "pattern": "*.pontodopedido.com/*", "zone_name": "pontodopedido.com" }
  // ],
  // Valores públicos (URL e chave publicável). Segredos nunca vão aqui.
  "vars": {
    "PDP_ROOT_DOMAIN": "pontodopedido.com",
    "PDP_PATH_TENANTS": "0"
  }
}
