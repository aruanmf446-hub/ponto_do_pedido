{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers (modelo compatível com Next.js via OpenNext).
  // O "Pages" clássico não executa o runtime do Next.js 16 (App Router,
  // Server Actions, proxy); por isso o deploy usa Workers + Assets.
  "name": "ponto-do-pedido",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "ponto-do-pedido" }],
  "observability": { "enabled": true },
  // Domínio principal e subdomínios dos restaurantes. Exigem a zona
  // pontodopedido.com na mesma conta Cloudflare e um registro DNS curinga
  // (*.pontodopedido.com) com proxy ativo. Só entram em vigor no deploy.
  "routes": [
    { "pattern": "pontodopedido.com/*", "zone_name": "pontodopedido.com" },
    { "pattern": "*.pontodopedido.com/*", "zone_name": "pontodopedido.com" }
  ],
  // Valores públicos (URL e chave publicável). Segredos nunca vão aqui.
  "vars": {
    "PDP_ROOT_DOMAIN": "pontodopedido.com",
    "PDP_PATH_TENANTS": "0"
  }
}
