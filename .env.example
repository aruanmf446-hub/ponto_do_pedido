# Ponto do Pedido — variáveis de ambiente (somente nomes; valores no provedor).
# Nenhuma chave secreta (service_role / sb_secret_) é usada pela aplicação Next.js.

# Domínio atual. Trocar para pontodopedido.com somente após comprovar domínio, DNS e TLS.
PDP_ROOT_DOMAIN=pontodopedido.vercel.app

# Projeto Supabase operacional e autoridade de identidade (pontodopedido)
PDP_APP_SUPABASE_URL=https://qmhtzosfbosgolevnybd.supabase.co
PDP_APP_SUPABASE_PUBLISHABLE_KEY=

# Projeto Supabase comercial (assinaturas)
PDP_BILLING_SUPABASE_URL=https://bjtlookhgkdltdohzxnq.supabase.co
PDP_BILLING_SUPABASE_PUBLISHABLE_KEY=

# Fallback atual, inclusive em produção enquanto o wildcard não está operacional.
PDP_PATH_TENANTS=1
# Preferir subdomínios SOMENTE após Vercel, wildcard DNS e TLS comprovados.
# Esta flag não configura DNS nem comprova propriedade.
PDP_TENANT_SUBDOMAINS_READY=0
